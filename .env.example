# Copy this file to .env and fill in the real values. Never commit .env.

# ---------- App ----------
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ---------- Database ----------
# Password is the one set for the "postgres" user when PostgreSQL was installed.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dent_detection
DB_USER=postgres
DB_PASSWORD=

# ---------- JWT ----------
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=dent-inspections

# ---------- Model ----------
# mock = synthetic output, no weights needed (used by the tests).
# ultralytics = the real YOLO11m model.
MODEL_BACKEND=ultralytics
MODEL_PATH=models/best.pt
MODEL_NAME=autodent-yolo11m
MODEL_VERSION=1.0.0

# Documented defaults from DOCUMENTATION.md (Balanced mode). These are only the
# fallback: sensitivity is chosen per inspection via a preset, so a client can
# ask for Sensitive without changing any of this.
MODEL_CONFIDENCE_THRESHOLD=0.35
MODEL_IOU_THRESHOLD=0.45
# 640 matches the dent-detection sibling project - ~2.5-3x faster than 1024,
# see test-model/README.md for the benchmark.
MODEL_INPUT_SIZE=640

# Which preset applies when a client does not name one.
# balanced (0.35) | sensitive (0.22) | strict (0.50)
DEFAULT_DETECTION_PRESET=balanced

# The model always runs at this floor and the backend filters afterwards.
# Ultralytics applies `conf` after the forward pass, so a lower floor is free,
# and it lets the report say how many findings sat below the threshold instead
# of dropping them silently. Must be <= the lowest preset confidence.
MODEL_DETECTION_FLOOR=0.15

# Test-time augmentation. Roughly triples inference time - leave off on CPU.
MODEL_AUGMENT=false

# Enhancement 2: retry at a lower threshold with TTA if the first pass is empty.
# Off by default - roughly doubles inference time on any image with no
# obvious damage, and dent-detection does not do this either.
MODEL_FALLBACK_ENABLED=false
MODEL_FALLBACK_MIN_CONF=0.15

# Enhancement 3: CLAHE contrast boost for glare/shadow. Opt-in.
MODEL_USE_CLAHE=false

# ---------- Inference / images ----------
MAX_IMAGES_PER_INSPECTION=10
MAX_IMAGE_BYTES=10485760
IMAGE_DOWNLOAD_TIMEOUT=20
INFERENCE_MAX_RETRIES=3
# Keep this low on CPU - each worker holds its own copy of the model in memory.
INFERENCE_WORKERS=2

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
